{
  "uid": "sdi-data-quality",
  "title": "SDI \u2014 Data Quality",
  "tags": [
    "sdi",
    "phase1",
    "dq"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rows rejected (window)",
      "description": "Rows that failed a REJECT rule in the selected range (from meta.dq_log).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(rows_failed) FILTER (WHERE rule_action='REJECT'),0) AS rejected\nFROM meta.dq_log WHERE $__timeFilter(logged_at);"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rows warned (window)",
      "description": "Rows that tripped a WARN rule (loaded, but flagged) in the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(rows_failed) FILTER (WHERE rule_action='WARN'),0) AS warned\nFROM meta.dq_log WHERE $__timeFilter(logged_at);"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rules evaluated (window)",
      "description": "Distinct validation rules checked in the selected range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(DISTINCT rule_id) AS rules\nFROM meta.dq_log WHERE $__timeFilter(logged_at);"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
