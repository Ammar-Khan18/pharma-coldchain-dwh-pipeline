        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Validation runs (window)",
      "description": "Number of transform runs that logged data-quality checks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(DISTINCT etl_batch_id) AS runs\nFROM meta.dq_log WHERE $__timeFilter(logged_at);"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Per-run data-quality summary",
      "description": "Each validation run: rules checked, rows rejected and rows warned.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT etl_batch_id AS \"run\",\n       count(*) AS \"rules logged\",\n       sum(rows_checked) AS \"rows checked\",\n       COALESCE(sum(rows_failed) FILTER (WHERE rule_action='REJECT'),0) AS \"rejected\",\n       COALESCE(sum(rows_failed) FILTER (WHERE rule_action='WARN'),0) AS \"warned\",\n       max(logged_at) AS \"time\"\nFROM meta.dq_log\nGROUP BY etl_batch_id ORDER BY max(logged_at) DESC LIMIT 20;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Per-rule pass/fail (latest run)",
      "description": "For the most recent run: each rule, its action, rows checked and rows failed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT rule_id AS \"rule\", rule_action AS \"action\",\n       sum(rows_checked) AS \"checked\", sum(rows_failed) AS \"failed\"\nFROM meta.dq_log\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.dq_log ORDER BY logged_at DESC LIMIT 1)\nGROUP BY rule_id, rule_action ORDER BY rule_id;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
