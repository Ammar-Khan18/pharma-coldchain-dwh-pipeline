    {
      "id": 6,
      "type": "table",
      "title": "Per-table rows & size by layer",
      "description": "Every measured table in the latest snapshot: layer, domain, rows and MB.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT layer, source_domain AS domain, table_name, row_count AS rows, size_mb AS \"size (MB)\"\nFROM meta.storage_snapshot\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.storage_snapshot ORDER BY snapshot_at DESC LIMIT 1)\nORDER BY layer, table_name;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Fact date coverage",
      "description": "Date span and number of distinct year-months held by each fact / ODS table.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT table_name, min_date AS \"min date\", max_date AS \"max date\",\n       distinct_year_months AS \"year-months\"\nFROM meta.storage_snapshot\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.storage_snapshot ORDER BY snapshot_at DESC LIMIT 1)\n  AND distinct_year_months IS NOT NULL\nORDER BY table_name;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
