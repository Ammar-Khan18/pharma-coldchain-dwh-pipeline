{
  "uid": "sdi-storage",
  "title": "SDI \u2014 Storage",
  "tags": [
    "sdi",
    "phase1",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "piechart",
      "title": "Storage share (MB) by source domain",
      "description": "Share of disk (MB) used by each source domain in the latest snapshot.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT source_domain, sum(size_mb) AS mb\nFROM meta.storage_snapshot\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.storage_snapshot ORDER BY snapshot_at DESC LIMIT 1)\n  AND size_mb IS NOT NULL\nGROUP BY source_domain ORDER BY mb DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Row share by source domain (mart)",
      "description": "Share of rows per source domain in the served mart (latest snapshot).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT source_domain, sum(row_count) AS rows\nFROM meta.storage_snapshot\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.storage_snapshot ORDER BY snapshot_at DESC LIMIT 1)\n  AND layer='mart' AND row_count IS NOT NULL\nGROUP BY source_domain ORDER BY rows DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
