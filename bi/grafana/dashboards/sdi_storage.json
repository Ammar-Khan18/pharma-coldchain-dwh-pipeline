          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total rows stored (all layers)",
      "description": "Sum of row counts across ods + meta + mart + duckdb (latest snapshot).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
      },
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ida_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(row_count) AS total_rows\nFROM meta.storage_snapshot\nWHERE etl_batch_id=(SELECT etl_batch_id FROM meta.storage_snapshot ORDER BY snapshot_at DESC LIMIT 1);"
        }
      ],
