      "id": 5,
      "type": "stat",
      "title": "DuckDB file size (MB)",
      "description": "Size of the sdi_mart.duckdb OLAP file (latest snapshot).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ida_postgres"
